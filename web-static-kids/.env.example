# Copy to `.env.local` for local dev (Kids app is served under /CPL-Auction/Kids/ on GitHub Pages).
#
# Kids uses its own Firebase project (see FIREBASE-SETUP.md). Do not reuse main CPL values.

VITE_BASE=/CPL-Auction/Kids/

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=cpl-auction-kids.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://cpl-auction-kids-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=cpl-auction-kids
# Optional — uploads use Realtime Database only; Storage bucket is not required.
# VITE_FIREBASE_STORAGE_BUCKET=cpl-auction-kids.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
