{
  "rules": {
    ".read": true,
    ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !root.child('admins').hasChildren())",

    "admins": {
      "$uid": {
        ".validate": "newData.isBoolean() || newData.val() == null"
      }
    },
    "tournament": {
      ".validate": "newData.val() == null || newData.hasChild('name')"
    },
    "teams": {
      "$teamId": {
        ".validate": "newData.val() == null || (newData.hasChild('name') && newData.hasChild('shortCode') && newData.hasChild('totalBudget') && newData.hasChild('reserveBalance') && (newData.hasChild('caption') || newData.hasChild('owner')))"
      }
    },
    "players": {
      "$playerId": {
        ".validate": "newData.val() == null || (newData.hasChild('number') && newData.hasChild('name') && newData.hasChild('status'))"
      }
    },
    "state": {
      ".validate": "newData.val() == null || newData.hasChild('currentBid')"
    },
    "bids": {
      "$playerId": {
        "$bidId": {
          ".validate": "newData.val() == null || (newData.hasChild('teamId') && newData.hasChild('amount'))"
        }
      }
    }
  }
}
